# Backend environment template. Copy to .env and adjust per environment.
# Never commit real values.

APP_NAME="WhatsApp AI SaaS API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true

# Comma-separated list of allowed CORS origins (no trailing slash).
CORS_ORIGINS="http://localhost:3000"

# Same Supabase project used by the frontend. Public key only; no service-role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Private knowledge uploads. Bucket name is fixed to the migration-managed bucket.
# MAX_DOCUMENT_SIZE_MB may be lowered (1-20); the bucket ceiling is 20 MiB.
KNOWLEDGE_BUCKET_NAME="knowledge-documents"
MAX_DOCUMENT_SIZE_MB=20

# Chunking strategy: overlap at most half the size, minimum below the size.
DOCUMENT_CHUNK_SIZE=1000
DOCUMENT_CHUNK_OVERLAP=150
DOCUMENT_MIN_CHUNK_CHARS=200

# Document indexing (Phase 2.7). The dimension must match the pgvector column
# (1536) until a controlled re-embedding migration changes it.
EMBEDDING_PROVIDER="openai"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSIONS=1536
# Server-side secret only; never exposed to the browser or committed.
OPENAI_API_KEY=

# AI text generation (Phase 3.1); independent from EMBEDDING_*.
# Choose openai, mistral or deepseek and an available chat-completion model ID.
# AI_MODEL is required when generation is called; unused generation does not block startup.
AI_PROVIDER="mistral"
AI_MODEL="mistral-small-latest"
AI_MAX_OUTPUT_TOKENS=1024
AI_TIMEOUT_SECONDS=60
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
